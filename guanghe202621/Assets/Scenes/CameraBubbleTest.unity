--- !u!114 &2003
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e0b9a000832f4c9689c9fae3c6da0004, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  defaultSpeaker: {fileID: 2001}
  triggerMode: 2
  triggerTag: Player
  loopConversations: 1
  conversations:
  - id: intro
    allowReplay: 1
    lines:
    - speaker: {fileID: 2001}
      speakerName: 向导
      narration: 0
      text: "你好，这是我们的第一次对话。现在台词显示在屏幕底部，你可以移动玩家观察效果。"
      duration: 2.5
      delayAfter: 0.3
      typewriter: 1
      headOffset: {x: 0, y: 1.1, z: 0}
    - speaker: {fileID: 1001}
      speakerName: 玩家
      narration: 0
      text: "好的，我的回答也会出现在同一个底部对话框里，角色名称会随说话人切换。"
      duration: 3
      delayAfter: 0.3
      typewriter: 0
      headOffset: {x: 0, y: 1.1, z: 0}
  - id: quest_done
    allowReplay: 1
    lines:
    - speaker: {fileID: 2001}
      speakerName: 向导
      narration: 0
      text: "欢迎回来！这是后续剧情中的另一段对话，仍然使用同一套对话框。"
      duration: 3
      delayAfter: 0.3
      typewriter: 1
      headOffset: {x: 0, y: 1.1, z: 0}
    - speaker: {fileID: 1001}
      speakerName: 玩家
      narration: 0
      text: "选择黄色对话角色，在面板的“对话分组”和“台词列表”中就能继续添加内容。"
      duration: 3
      delayAfter: 0.3
      typewriter: 0
      headOffset: {x: 0, y: 1.1, z: 0}
  onConversationStarted:
    m_PersistentCalls:
      m_Calls: []
  onConversationFinished:
    m_PersistentCalls:
      m_Calls: []
